# RAGForge — Environment Variables
# Copy this file to .env and fill in the values

# ─── Database ───
DATABASE_URL=postgresql+asyncpg://ragforge:ragforge@localhost:5432/ragforge
DATABASE_URL_SYNC=postgresql://ragforge:ragforge@localhost:5432/ragforge
POSTGRES_USER=ragforge
POSTGRES_PASSWORD=ragforge
POSTGRES_DB=ragforge

# ─── Groq API ───
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ─── Embedding ───
EMBEDDING_PROVIDER=sentence-transformer
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# ─── Reranker ───
RERANKER_PROVIDER=cross-encoder
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ─── Application ───
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ─── Ingestion ───
MAX_FILE_SIZE_MB=50
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# ─── Retrieval ───
VECTOR_SEARCH_TOP_K=20
KEYWORD_SEARCH_TOP_K=20
RERANK_TOP_K=8
MIN_EVIDENCE_THRESHOLD=0.3

# ─── Security ───
CORS_ORIGINS=["http://localhost:3000"]
RATE_LIMIT_PER_MINUTE=60
